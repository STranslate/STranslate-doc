{
  "name": "stranslate-doc",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist --force-language zh-cn && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write src scripts tests astro.config.mjs playwright.config.ts *.json *.md",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "validate:plugins": "node scripts/validate-plugins.cjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "pagefind": "1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3"
  }
}
